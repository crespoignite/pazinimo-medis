---
// Concentric broken arcs from the 2026 identity (the ring device of the logo). Decorative only.
const { side = 'right' } = Astro.props as { side?: 'left' | 'right' };
---
<div class={`deco arcs ${side}`} aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false" fill="none" stroke-linecap="butt" stroke="currentColor" stroke-width="4">
    <circle cx="200" cy="200" r="190" pathLength="100" stroke-dasharray="86 14" stroke-dashoffset="-30"/>
    <circle cx="200" cy="200" r="150" pathLength="100" stroke-dasharray="72 28" stroke-dashoffset="-6"/>
    <circle cx="200" cy="200" r="110" pathLength="100" stroke-dasharray="64 36" stroke-dashoffset="-52"/>
    <circle cx="200" cy="200" r="70" pathLength="100" stroke-dasharray="58 42" stroke-dashoffset="-20"/>
    <circle cx="200" cy="200" r="30" pathLength="100" stroke-dasharray="70 30" stroke-dashoffset="-70"/>
  </svg>
</div>
