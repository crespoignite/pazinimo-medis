---
// Concentric arcs from the school identity (brand book 2.09). Decorative only.
const { side = 'right' } = Astro.props as { side?: 'left' | 'right' };
---
<div class={`deco arcs ${side}`} aria-hidden="true">
  <svg viewBox="0 0 400 400" focusable="false" fill="none" stroke-linecap="butt">
    <circle cx="200" cy="200" r="190" stroke="#6d53d4" stroke-width="16" pathLength="100" stroke-dasharray="34 66" stroke-dashoffset="-8"/>
    <circle cx="200" cy="200" r="160" stroke="#0088ff" stroke-width="16" pathLength="100" stroke-dasharray="52 48" stroke-dashoffset="-30"/>
    <circle cx="200" cy="200" r="130" stroke="#0007d6" stroke-width="16" pathLength="100" stroke-dasharray="30 70" stroke-dashoffset="-2"/>
    <circle cx="200" cy="200" r="100" stroke="#00c7c7" stroke-width="16" pathLength="100" stroke-dasharray="40 60" stroke-dashoffset="-46"/>
    <circle cx="200" cy="200" r="70" stroke="#6d53d4" stroke-width="16" pathLength="100" stroke-dasharray="46 54" stroke-dashoffset="-14"/>
  </svg>
</div>
