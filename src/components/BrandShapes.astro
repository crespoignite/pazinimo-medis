---
// Concentric arc fragments from the 2026 identity, replacing the 2025 broken-outline shapes.
// Decorative only. Place inside a position:relative section. `s` is kept for compatibility and ignored.
export interface Item { s?: string; x: number; y: number; w: number; r?: number; m?: boolean; }
const { items = [] } = Astro.props as { items?: Item[] };
const rings: [number, number, number][] = [[54, 74, -8], [40, 62, -40], [26, 58, -16], [12, 66, -60]];
---
<div class="deco" aria-hidden="true">
  {items.map((it, i) => (
    <svg class={`shape c${i % 3}${it.m ? ' hide-m' : ''}`} viewBox="0 0 120 120" style={`left:${it.x}%;top:${it.y}%;width:${Math.round(it.w * 1.5)}px;transform:rotate(${it.r || 0}deg)`} focusable="false" fill="none" stroke="currentColor" stroke-width="1.6">
      {rings.map(([rad, len, off]) => <circle cx="60" cy="60" r={rad} pathLength="100" stroke-dasharray={`${len} ${100 - len}`} stroke-dashoffset={off} />)}
    </svg>
  ))}
</div>
