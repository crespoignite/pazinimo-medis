---
import { useT, localePath, type Lang } from '../i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
// Switch the banner on or off with site.campaign.enabled. Text and link come from the active campaign.
---
{site.campaign.enabled && (
  <div class="campbar"><div class="wrap">
    <a class="campaign" role="region" aria-label={t('banner.aria')} href={localePath(lang, `campaign/${site.campaign.slug}`)} data-cta="campaign_banner">
      <span><span class="c-t">{t('banner.head')}</span><span class="c-s">{t('banner.sub')}</span></span>
      <span class="c-b">{t('banner.cta')}</span>
    </a>
  </div></div>
)}
