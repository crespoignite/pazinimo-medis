---
import Photo from './Photo.astro';
import { useT, localePath, type Lang } from '../i18n';
const { lang, ratio = '21/9' } = Astro.props as { lang: Lang; ratio?: string };
const t = useT(lang);
const slides = [
  { href: 'kindergarten', k: 'hero.1', tone: 'k' },
  { href: 'school', k: 'hero.2', tone: 's' },
  { href: 'about/programs', k: 'hero.3', tone: '' },
  { href: 'about/news', k: 'hero.4', tone: '' },
];
---
<section class="carousel" data-carousel aria-roledescription="carousel" aria-label={t('site.name')}>
  <div class="slides" aria-live="off">
    {slides.map((s, i) => (
      <a class="slide" href={localePath(lang, s.href)} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${slides.length}`} data-cta={`hero_${i + 1}`}>
        <Photo lang={lang} tone={s.tone as any} ratio={ratio} label={t(`${s.k}.t`)} />
        <div class="cap"><strong>{t(`${s.k}.t`)}</strong><span>{t(`${s.k}.d`)}</span></div>
      </a>
    ))}
  </div>
  <div class="c-dots">
    {slides.map((_, i) => <button type="button" aria-label={t('hero.goto', { n: i + 1 })} aria-current={i === 0 ? 'true' : undefined} data-dot={i}></button>)}
  </div>
  <div class="c-ctl">
    <button type="button" data-prev aria-label={t('hero.prev')}>‹</button>
    <button type="button" data-next aria-label={t('hero.next')}>›</button>
    <button type="button" data-toggle aria-label={t('hero.pause')} data-pause={t('hero.pause')} data-play={t('hero.play')}>❚❚</button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.slides')!;
    const n = track.children.length; const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const tog = root.querySelector<HTMLElement>('[data-toggle]')!;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer: any = null, playing = !reduce;
    const go = (k: number) => { i = (k + n) % n; track.style.transform = `translateX(-${i * 100}%)`; dots.forEach((d, j) => d.setAttribute('aria-current', String(j === i))); };
    const start = () => { stop(); if (playing) timer = setInterval(() => go(i + 1), 6000); };
    const stop = () => timer && clearInterval(timer);
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(i - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(i + 1));
    dots.forEach((d, j) => d.addEventListener('click', () => go(j)));
    tog.addEventListener('click', () => { playing = !playing; tog.textContent = playing ? '❚❚' : '▶'; tog.setAttribute('aria-label', tog.dataset[playing ? 'pause' : 'play']!); playing ? start() : stop(); });
    root.addEventListener('mouseenter', stop); root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop); root.addEventListener('focusout', start);
    root.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'ArrowLeft') go(i - 1); if (e.key === 'ArrowRight') go(i + 1); });
    if (reduce) tog.textContent = '▶';
    start();
  });
</script>
