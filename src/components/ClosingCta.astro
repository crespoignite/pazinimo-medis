---
import { useT, localePath, type Lang } from '../i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
---
<section class="close-cta on-cobalt" aria-labelledby="h-close">
  <svg class="close-arcs" viewBox="0 0 800 800" aria-hidden="true" focusable="false" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round">
    <circle cx="560" cy="400" r="120" pathLength="100" stroke-dasharray="72 28" transform="rotate(200 560 400)" opacity=".9"/>
    <circle cx="560" cy="400" r="200" pathLength="100" stroke-dasharray="66 34" transform="rotate(30 560 400)" opacity=".8"/>
    <circle cx="560" cy="400" r="280" pathLength="100" stroke-dasharray="70 30" transform="rotate(290 560 400)" opacity=".65"/>
    <circle cx="560" cy="400" r="360" pathLength="100" stroke-dasharray="62 38" transform="rotate(110 560 400)" opacity=".5"/>
    <circle cx="560" cy="400" r="440" pathLength="100" stroke-dasharray="58 42" transform="rotate(200 560 400)" opacity=".35"/>
  </svg>
  <div class="wrap close-in">
    <img class="close-logo" src={site.logoWhite} alt={t('site.name')} width="220" height="87" />
    <h2 id="h-close" class="tag-stack"><span class="s">{t('close.w1')}</span><span class="v">{t('close.w2')}</span><span class="t">{t('close.w3')}</span></h2>
    <p class="lead">{t('close.d')}</p>
    <div class="row">
      <a class="btn accent" href={p('admissions/book')} data-cta="close_book">{t('cta.book')}</a>
      <a class="btn ghost" href={p('admissions/ask')} data-cta="close_ask">{t('cta.ask')}</a>
    </div>
    <p class="close-contact"><span>{t('close.call')} <a href={site.phoneHref}>{site.phone}</a></span><span>{t('close.write')} <a href={`mailto:${site.email}`}>{site.email}</a></span></p>
  </div>
</section>
