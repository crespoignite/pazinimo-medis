---
// Ported from the concept: the closing poster with the drifting arcs and the call to action.
import { useT, localePath, type Lang } from '../i18n';
import { site } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
---
<section class="cclose cx cx-cobalt" id="closing" aria-labelledby="h-close">
  <svg class="flight" viewBox="0 0 800 800" aria-hidden="true" id="flight"><g fill="none" stroke-linecap="round"></g></svg>
  <div class="wrap">
    <h2 class="slogan" id="h-close">{t('site.slogan')}</h2>
    <div class="cx-ctas">
      <a class="cx-btn primary" href={p('admissions/book')} data-cta="close_book">{t('cta.book')} <span class="arr" aria-hidden="true">→</span></a>
    </div>
    <p class="contact"><span>{t('close.call')} <b><a href={site.phoneHref}>{site.phone}</a></b></span><span>{t('close.write')} <b><a href={`mailto:${site.email}`}>{site.email}</a></b></span></p>
  </div>
</section>
