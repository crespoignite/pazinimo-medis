---
import { useT, localePath, type Lang } from '../i18n';
import { stepImages } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
const cols = [['#ffffff', '#97bdfb', '#00bfbf'], ['#97bdfb', '#00bfbf', '#ffffff'], ['#00bfbf', '#ffffff', '#97bdfb'], ['#ffffff', '#00bfbf', '#97bdfb']];
const rot = [[20, 140, 260], [70, 200, 330], [120, 250, 10], [170, 300, 60]];
---
<section class="section on-cobalt steps-sec" aria-labelledby="join">
  <div class="wrap">
    <h2 id="join">{t('home.join.title')}</h2>
    {t('home.join.sub') && <p class="steps-sub"><span class="tagb s">{t('home.join.sub')}</span></p>}
    {t('home.join.body') && <p class="lead">{t('home.join.body')}</p>}
    <ol class="jsteps">
      {[1, 2, 3, 4].map((n) => (
        <li>
          <div class="jpic"><img src={stepImages[n - 1]} alt={t(`steps.alt${n}`)} loading="lazy" width="800" height="534" /></div>
          <div class="jhead">
            <svg class="jsym" viewBox="0 0 56 56" aria-hidden="true" focusable="false">
              <g fill="none" stroke-width="2.2" stroke-linecap="round">
                {[25, 19.5, 14].map((r, i) => <circle cx="28" cy="28" r={r} stroke={cols[n - 1][i]} pathLength="100" stroke-dasharray={`${76 - i * 6} ${24 + i * 6}`} transform={`rotate(${rot[n - 1][i]} 28 28)`} />)}
              </g>
              <text x="28" y="33.5" text-anchor="middle" fill="#fff" font-size="15" font-weight="500">{n}</text>
            </svg>
            <h3>{t(`step.${n}.t`)}</h3>
          </div>
          <p>{t(`step.${n}.d`)}</p>
        </li>
      ))}
    </ol>
    <div class="row" style="margin-top:28px">
      <a class="btn ghost" href={p('admissions/ask')} data-cta="home_ask">{t('cta.ask')}</a>
      <a class="btn accent" href={p('admissions/book')} data-cta="home_book_2">{t('cta.book')}</a>
    </div>
  </div>
</section>
