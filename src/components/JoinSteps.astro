---
// Ported from the concept: "Joining takes four steps", with ring-numbered steps and round photos.
import { useT, localePath, type Lang } from '../i18n';
import { stepImages } from '../data/site';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
const cols = [['#0045b6', '#785dd9', '#00bfbf'], ['#785dd9', '#00bfbf', '#0045b6'], ['#00bfbf', '#0045b6', '#785dd9'], ['#0a1b5b', '#0045b6', '#00bfbf']];
const rot = [[20, 140, 260], [70, 200, 330], [120, 250, 10], [170, 300, 60]];
---
<section class="cx cx-ice cx-join" aria-labelledby="join">
  <div class="wrap">
    <div class="cx-sechead">
      <h2 id="join">{t('home.join.title')}</h2>
      <p>{t('home.join.body') || t('home.join.sub')}</p>
    </div>
    <ol class="csteps">
      {[1, 2, 3, 4].map((n) => (
        <li>
          <div class="cpic"><img src={stepImages[n - 1]} alt={t(`steps.alt${n}`)} width="800" height="534" loading="lazy" /></div>
          <span class="n"><span class="sym" aria-hidden="true">
            <svg viewBox="0 0 56 56"><g fill="none" stroke-linecap="round" stroke-width="3.4">
              {[25, 19.5, 14].map((r, i) => <circle cx="28" cy="28" r={r} stroke={cols[n - 1][i]} pathLength="100" stroke-dasharray={`${76 - i * 6} ${24 + i * 6}`} transform={`rotate(${rot[n - 1][i]} 28 28)`} />)}
            </g></svg><i>{n}</i></span>{t(`step.${n}.t`)}</span>
          <p>{t(`step.${n}.d`)}</p>
        </li>
      ))}
    </ol>
    <div class="cx-ctas">
      <a class="cx-btn primary" href={p('admissions/book')} data-cta="home_book_2">{t('cta.book')} <span class="arr" aria-hidden="true">→</span></a>
      <a class="cx-btn secondary" href={p('admissions/ask')} data-cta="home_ask">{t('cta.ask')}</a>
    </div>
  </div>
</section>
