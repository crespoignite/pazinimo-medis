---
import { useT, localePath, type Lang } from '../i18n';
const { lang, kind } = Astro.props as { lang: Lang; kind: 'ask' | 'book' | 'campaign' };
const t = useT(lang);
const name = kind;
const isBook = kind === 'book';

// Education stages (Ugdymo pakopa) — matches the Pipedrive registration form.
const levels = [
  ['ikimokyklinis', t('form.level.preschool')],
  ['priesmokyklinis', t('form.level.prePrimary')],
  ['pradinis', t('form.level.primary')],
  ['progimnazinis', t('form.level.preGym')],
  ['gimnazinis', t('form.level.gym')],
];
// Campuses (Padalinys) — matches the Pipedrive registration form.
const branches = [
  ['kalinausko', t('form.branch.kalinausko')],
  ['ozo', t('form.branch.ozo')],
  ['pievu', t('form.branch.pievu')],
  ['vilties', t('form.branch.vilties')],
];
const years = ['2026-2027', '2027-2028', '2028-2029'];
---
<form class="form" name={name} method="POST" action="/" data-netlify="true" netlify-honeypot="bot-field" data-lead
  data-thanks={localePath(lang, 'thank-you')} data-sending={t('form.sending')} data-error={t('form.error')} data-pick={t('form.pick')}>
  <input type="hidden" name="form-name" value={name} />
  <p class="hp"><label>Do not fill <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
  {['lang','page','source','ab_variant','faq_topic','utm_source','utm_medium','utm_campaign','utm_content','utm_term'].map((n) => <input type="hidden" name={n} value={n === 'source' ? name : ''} />)}

  <div class="f"><label for={`${name}-name`}>{t('form.name')}</label><input id={`${name}-name`} name="name" autocomplete="name" required /></div>
  <div class="f"><label for={`${name}-email`}>{t('form.email')}</label><input id={`${name}-email`} name="email" type="email" autocomplete="email" required /></div>
  <div class="f"><label for={`${name}-phone`}>{t('form.phone')} {!isBook && <span class="opt">({t('form.optional')})</span>}</label><input id={`${name}-phone`} name="phone" type="tel" autocomplete="tel" required={isBook} /></div>

  {isBook ? (<>
    <fieldset class="f radios" data-cbgroup="school_year" data-required>
      <legend>{t('form.year')}</legend>
      {years.map((y) => <label class="radio"><input type="checkbox" value={y} /> {y}</label>)}
      <span class="hint">{t('form.year.help')}</span>
    </fieldset>
    <input type="hidden" name="school_year" />

    <div class="f"><label for="book-level">{t('form.level')}</label>
      <select id="book-level" name="stage" required>
        <option value="" disabled selected>{t('form.select')}</option>
        {levels.map(([v, l]) => <option value={v}>{l}</option>)}
      </select></div>

    <fieldset class="f radios" data-cbgroup="campus" data-required>
      <legend>{t('form.branch')}</legend>
      {branches.map(([v, l]) => <label class="radio"><input type="checkbox" value={v} /> {l}</label>)}
    </fieldset>
    <input type="hidden" name="campus" />

    <fieldset class="f radios"><legend>{t('form.meeting')}</legend>
      <label class="radio"><input type="radio" name="meeting" value="in_person" required /> {t('form.meeting.inPerson')}</label>
      <label class="radio"><input type="radio" name="meeting" value="remote" required /> {t('form.meeting.remote')}</label>
    </fieldset>

    <div class="f"><label for="book-when">{t('form.contactTime')} <span class="opt">({t('form.optional')})</span></label><input id="book-when" name="contact_time" /></div>
    <div class="f"><label for="book-note">{t('form.note')} <span class="opt">({t('form.optional')})</span></label><textarea id="book-note" name="message"></textarea></div>
  </>) : (<>
    <div class="f"><label for={`${name}-stage`}>{t('form.stage')}</label>
      <select id={`${name}-stage`} name="stage">
        <option value="kindergarten">{t('form.stage.k')}</option><option value="school">{t('form.stage.s')}</option><option value="unsure">{t('form.stage.unsure')}</option>
      </select></div>
    <div class="f"><label for={`${name}-city`}>{t('form.campus')}</label>
      <select id={`${name}-city`} name="city"><option value="vilnius">{t('home.city.vilnius')}</option><option value="kaunas">{t('home.city.kaunas')}</option></select></div>
    <div class="f"><label for={`${name}-child`}>{t('form.child')} <span class="opt">({t('form.optional')})</span></label><input id={`${name}-child`} name="child" /></div>
    <div class="f"><label for={`${name}-msg`}>{t('form.message')}</label><textarea id={`${name}-msg`} name="message" required></textarea></div>
  </>)}

  <div class="f check"><input id={`${name}-consent`} type="checkbox" name="consent" value="yes" required /><label for={`${name}-consent`}>{t('form.consent')}</label></div>
  <button class="btn accent" type="submit">{t('cta.send')}</button>
  <p class="status" data-status role="status" aria-live="polite"></p>
  <p class="campus-note">{t('form.reply')}</p>
</form>
