---
import { useT, type Lang } from '../i18n';
const { lang = 'en', label = '', ratio = '16/10', tone = '', alt = '', src = '', pos = '50% 50%' } = Astro.props as { lang?: Lang; label?: string; ratio?: string; tone?: 'k' | 's' | ''; alt?: string; src?: string; pos?: string };
const t = useT(lang);
---
{src
  ? <img class="pic" src={src} alt={alt || label} style={`aspect-ratio:${ratio};object-position:${pos}`} loading="lazy" decoding="async" />
  : <div class={`ph ${tone}`} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt || label || t('photo.label')}>{label || t('photo.label')}</div>}
