---
// Ported from the concept: the school's ring symbol changes colour with each stage, pinned while you scroll.
import { useT, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const photos = ['kindergarten-painting-girl', 'kindergarten-teacher-paint', 'school-swing-g3', 'school-girls-g5', 'school-teen-lab', 'school-highschool'];
const alts = ['img.kg.paintgirl', 'img.kg.teacher', 'img.sc.swing3', 'img.sc.girls5', 'img.sc.teen', 'img.sc.high'];
const dots = ['#00bfbf', '#97bdfb', '#2b8cfb', '#785dd9', '#ffffff', '#00bfbf'];
---
<section class="years cx cx-cobalt" id="years" aria-labelledby="h-years" data-kg={t('ring.kg')} data-g0={t('ring.g0')} data-grade={t('ring.grade')} data-flight={t('ring.flight')}>
  <div class="years-stage">
    <div class="years-ring">
      <svg id="yrSvg" viewBox="96 96 528 528" role="img" aria-label={t('ring.alt')}>
        <defs><clipPath id="yrCore"><circle cx="360" cy="360" r="172"/></clipPath></defs>
        <g clip-path="url(#yrCore)" id="yrPhotos">
          {photos.map((p, i) => <image href={`/photos/${p}.jpg`} x="188" y="188" width="344" height="344" preserveAspectRatio="xMidYMid slice" opacity={i === 0 ? 1 : 0}><title>{t(alts[i])}</title></image>)}
        </g>
        <g id="yrRings"></g>
      </svg>
    </div>
    <div class="years-copy">
      <p class="cx-label">{t('ring.label')}</p>
      <h2 id="h-years">{t('ring.title')}</h2>
      <div class="counter" aria-hidden="true"><span class="now" id="yrNow">{t('ring.kg')}</span></div>
      <div class="years-progress" aria-hidden="true"><span id="yrBar"></span></div>
      <ol class="chapters" id="chapters">
        {[0, 1, 2, 3, 4, 5].map((i) => (
          <li class={i === 0 ? 'on' : ''} style={`--c:${dots[i]}`}>
            <span class="cx-label stage"><i></i>{t(`ring.${i}.l`)}</span>
            <h3>{t(`ring.${i}.t`)}</h3>
            <p>{t(`ring.${i}.d`)}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
