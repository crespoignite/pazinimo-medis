---
import { divider } from '../data/site';
import { useT, type Lang } from '../i18n';
const { lang } = Astro.props as { lang: Lang };
const t = useT(lang);
const has = Boolean(divider.mp4 || divider.webm);
---
<section class="vdivider" aria-label={t('vd.aria')} data-parallax>
  <div class="vd-media" data-parallax-layer>
    {has ? (
      <video autoplay muted loop playsinline preload="metadata" poster={divider.poster || undefined} aria-hidden="true" tabindex="-1">
        {divider.webm && <source src={divider.webm} type="video/webm" />}
        {divider.mp4 && <source src={divider.mp4} type="video/mp4" />}
      </video>
    ) : (
      <div class="vd-ph" role="img" aria-label={t('vd.aria')}><span>{t('vd.placeholder')}</span></div>
    )}
  </div>
</section>
<style>
  .vdivider{position:relative;width:100%;height:500px;overflow:hidden;background:var(--ink)}
  .vd-media{position:absolute;left:0;right:0;top:-80px;bottom:-80px;will-change:transform}
  .vd-media video,.vd-ph{width:100%;height:100%;object-fit:cover;display:block}
  .vd-ph{display:flex;align-items:center;justify-content:center;text-align:center;padding:0 24px;color:#fff;font-weight:700;letter-spacing:.06em;text-transform:uppercase;font-size:.9rem;background:linear-gradient(135deg,var(--purple),var(--blue) 55%,var(--green))}
  @media (max-width:700px){.vdivider{height:360px}}
  @media (prefers-reduced-motion:reduce){.vd-media{top:0;bottom:0;transform:none!important}}
</style>
<script>
  const root = document.querySelector<HTMLElement>('[data-parallax]');
  const layer = root?.querySelector<HTMLElement>('[data-parallax-layer]');
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (root && layer && !still) {
    let tick = false;
    const update = () => {
      tick = false;
      const r = root.getBoundingClientRect();
      const vh = window.innerHeight;
      if (r.bottom < 0 || r.top > vh) return;
      const p = (r.top + r.height / 2 - vh / 2) / (vh / 2 + r.height / 2); // -1 to 1
      layer.style.transform = `translate3d(0, ${(-p * 60).toFixed(1)}px, 0)`;
    };
    addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(update); } }, { passive: true });
    addEventListener('resize', update);
    update();
    const v = layer.querySelector('video');
    if (v && 'IntersectionObserver' in window) {
      new IntersectionObserver((es) => es.forEach((e) => (e.isIntersecting ? v.play().catch(() => {}) : v.pause())), { threshold: 0.1 }).observe(root);
    }
  }
</script>
