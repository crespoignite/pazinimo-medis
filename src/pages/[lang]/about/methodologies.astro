---
import Layout from '../../../layouts/Layout.astro';
import { useT, type Lang } from '../../../i18n';
import { langPaths } from '../../../i18n/paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Layout lang={lang} title={t('me.title')} description={t('me.desc')} path="about/methodologies">
  <section class="section"><div class="wrap">
    <h1>{t('me.h1')}</h1><p class="lead">{t('me.lead')}</p>
    <div class="meth-list">{[1,2,3,4].map((n) => (
      <details class="meth">
        <summary><span><strong class="meth-t">{t(`sc.b${n}.t`)}</strong><span class="meth-d">{t(`sc.b${n}.d`)}</span></span></summary>
        <div class="meth-x"><p>{t(`me.b${n}.x`)}</p><p class="campus-note">{t('me.more')}</p></div>
      </details>
    ))}</div>
    <div class="card" style="margin-top:20px"><h3>{t('me.renzulli.t')}</h3><p>{t('me.renzulli.d')}</p></div>
  </div></section>
</Layout>
