---
import Layout from '../../../layouts/Layout.astro';
import LeadForm from '../../../components/LeadForm.astro';
import { useT, type Lang } from '../../../i18n';
import { langPaths } from '../../../i18n/paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Layout lang={lang} title={t('form.title.book') + ' | Pažinimo medis'} path="admissions/book" bare noindex>
  <section class="section" style="padding-top:12px">
    <div class="wrap" style="display:flex;flex-direction:column;align-items:center">
      <h1 style="font-size:clamp(1.8rem,4vw,2.6rem);text-align:center">{t('form.title.book')}</h1>
      <LeadForm lang={lang} kind="book" />
    </div>
  </section>
</Layout>
