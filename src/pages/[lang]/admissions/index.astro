---
import { hl } from '../../../i18n/hl';
import JoinSteps from '../../../components/JoinSteps.astro';
import Layout from '../../../layouts/Layout.astro';
import FaqList from '../../../components/FaqList.astro';
import { useT, localePath, type Lang } from '../../../i18n';
import { langPaths } from '../../../i18n/paths';
import { faqs } from '../../../data/faq';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
const items = ['admission', 'after-signing', 'price', 'subsidies'].map((id) => faqs.find((f) => f.id === id)!);
const tcols = [['#0045b6', '#785dd9', '#00bfbf'], ['#785dd9', '#00bfbf', '#0045b6'], ['#00bfbf', '#0045b6', '#785dd9']];
const trot = [[20, 140, 260], [70, 200, 330], [120, 250, 10]];
---
<Layout lang={lang} title={t('ad.title')} description={t('ad.desc')} path="admissions">
  <section class="section">
    <div class="wrap">
      <h1>{t('ad.h1')}</h1>
      <p class="lead">{t('ad.lead')}</p>
    </div>
  </section>
  <JoinSteps lang={lang} title={t('ad.steps.title')} body="" ctas={false} />
  <section class="section alt">
    <div class="wrap">
      <h2 set:html={hl(t('ad.doors.title'))}></h2>
      <div class="grid g2">
        <div class="card p"><h3>{t('ad.ask.t')}</h3><p>{t('ad.ask.d')}</p><a class="btn ghost" href={p('admissions/ask')} data-cta="adm_ask">{t('cta.ask')}</a></div>
        <div class="card p"><h3>{t('ad.book.t')}</h3><p>{t('ad.book.d')}</p><a class="btn accent" href={p('admissions/book')} data-cta="adm_book">{t('cta.book')}</a></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap"><h2 set:html={hl(t('ad.next.title'))}></h2>
      <ol class="tline">{[1, 2, 3].map((n) => (
        <li>
          <span class="sym" aria-hidden="true">
            <svg viewBox="0 0 56 56"><g fill="none" stroke-linecap="round" stroke-width="3.4">
              {[25, 19.5, 14].map((r, i) => <circle cx="28" cy="28" r={r} stroke={tcols[n - 1][i]} pathLength="100" stroke-dasharray={`${76 - i * 6} ${24 + i * 6}`} transform={`rotate(${trot[n - 1][i]} 28 28)`} />)}
            </g></svg><i>{n}</i></span>
          <p>{t(`ad.next.${n}`)}</p>
        </li>
      ))}</ol>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap"><h2 set:html={hl(t('ad.faq.title'))}></h2><FaqList lang={lang} items={items} /></div>
  </section>
</Layout>
