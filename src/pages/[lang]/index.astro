---
import { hl } from '../../i18n/hl';
import FaqList from '../../components/FaqList.astro';
import Rings from '../../components/Rings.astro';
import Layout from '../../layouts/Layout.astro';
import HeroCover from '../../components/HeroCover.astro';
import Photo from '../../components/Photo.astro';
import NewsList from '../../components/NewsList.astro';
import Benefits from '../../components/Benefits.astro';
import { useT, localePath, pick, has, type Lang } from '../../i18n';
import { langPaths } from '../../i18n/paths';
import { topFaqs } from '../../data/faq';
import { startingFrom } from '../../data/pricing';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
// The benefit accordions only show in a language that has its own text for them (no English inside the Lithuanian page).
const showBenefits = has(lang, 'ben.k.1.t');
const how = [['home.how.1', 'about/methodologies'], ['home.how.2', 'about/programs'], ['home.how.3', 'faq#k-meals'], ['home.how.4', 'faq#s-class-size']];
const heroSlides = [
  { src: '/photos/kindergarten-hands-up.jpg', alt: t('img.kg.hands'), pos: '50% 45%' },
  { src: '/photos/school-drum.jpg', alt: t('img.sc.drum'), pos: '50% 40%' },
  { src: '/photos/school-grade5.jpg', alt: t('img.sc.grade5'), pos: '50% 40%' },
  { src: '/photos/school-teen-lab.jpg', alt: t('img.sc.teen'), pos: '50% 35%' },
  { src: '/photos/school-highschool.jpg', alt: t('img.sc.high'), pos: '50% 30%' },
];
import JoinSteps from '../../components/JoinSteps.astro';
import ClosingCta from '../../components/ClosingCta.astro';
---
<Layout lang={lang} title={t('home.title')} description={t('home.desc')} path="">
  <section class="hero" aria-labelledby="h1">
    <HeroCover lang={lang} slides={heroSlides}>
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1 id="h1">{t('home.opener')}</h1>
      {t('home.tagline') && <p class="hero-tag"><span class="mark">{t('home.tagline')}</span></p>}
      <p class="lead">{t('home.valueprop')}</p>
      <p><a class="btn accent" href={p('admissions/book')} data-cta="home_book">{t('home.hero.cta')}</a></p>
      <div class="hero-foot">
        <p class="proof-line proof-hero"><strong>{t('home.proof')}</strong> <small class="campus-note">(<a href="https://topmokyklos.lt/" target="_blank" rel="noopener">{t('home.proofSource')}</a>)</small></p>
        <span class="slogan mark">{t('site.slogan')}</span>
      </div>
    </HeroCover>
  </section>

  <section class="section" aria-labelledby="values">
    <div class="wrap">
      <h2 id="values" set:html={hl(t('home.values.title'))}></h2>
      {t('home.values.g1') && <h3 class="vals-h">{t('home.values.g1')}</h3>}
      <div class="grid g2">
        {[1, 2].map((n) => (
          <div class="card p"><h3>{t(`home.values.${n}.t`)}</h3><p>{t(`home.values.${n}.d`)}</p></div>
        ))}
      </div>
      {t('home.values.g2') && <h3 class="vals-h" style="margin-top:28px">{t('home.values.g2')}</h3>}
      <div class="grid g3" style="margin-top:20px">
        {[3, 4, 5].map((n) => (
          <div class="card p"><h3>{t(`home.values.${n}.t`)}</h3><p>{t(`home.values.${n}.d`)}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-sky" aria-labelledby="stage">
    <div class="wrap">
      <h2 id="stage" set:html={hl(t('home.stage.title'))}></h2>
      <div class="grid g2">
        <div class="card k stage-card">
          <Rings tone="k" />
          <h3>{t('home.stage.k.t')}</h3><p>{t('home.stage.k.d')}</p>
          <div class="cities">
            <a class="btn sm teal" href={p('kindergarten') + '#vilnius'} data-cta="home_k_vilnius">{t('home.city.vilnius')}</a>
            <a class="btn sm teal" href={p('kindergarten') + '#kaunas'} data-cta="home_k_kaunas">{t('home.city.kaunas')}</a>
            <a class="btn sm ghost" href={p('kindergarten')}>{t('cta.learnMore')}</a>
          </div>
        </div>
        <div class="card s stage-card">
          <Rings tone="s" />
          <h3>{t('home.stage.s.t')}</h3><p>{t('home.stage.s.d')}</p>
          <div class="cities">
            <a class="btn sm cobalt" href={p('school') + '#vilnius'} data-cta="home_s_vilnius">{t('home.city.vilnius')}</a>
            <a class="btn sm cobalt" href={p('school') + '#kaunas'} data-cta="home_s_kaunas">{t('home.city.kaunas')}</a>
            <a class="btn sm ghost" href={p('school')}>{t('cta.learnMore')}</a>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section band-peach" aria-labelledby="price">
    <div class="wrap">
      <h2 id="price" set:html={hl(t('home.pricing.title'))}></h2>
      <p class="lead">{t('home.pricing.sub')}</p>
      <div class="grid g2">
        <div class="stage-col">
          <a class="card k" href={p('pricing') + '#kindergarten'} style="text-decoration:none;display:block"><h3>{t('pr.tab.k')}</h3><p class="num">{t('pr.fromAmount', { n: startingFrom.kindergarten })}</p><p class="campus-note">{t('pr.monthlyNote')}</p></a>
          {showBenefits && <h3 class="ben-h" style="color:var(--green-ink)">{t('home.benefits.k')}</h3>}
          {showBenefits && <Benefits lang={lang} stage="k" />}
        </div>
        <div class="stage-col">
          <a class="card s" href={p('pricing') + '#school'} style="text-decoration:none;display:block"><h3>{t('pr.tab.s')}</h3><p class="num">{t('pr.fromAmount', { n: startingFrom.school })}</p><p class="campus-note">{t('pr.monthlyNote')}</p></a>
          {showBenefits && <h3 class="ben-h" style="color:var(--blue-ink)">{t('home.benefits.s')}</h3>}
          {showBenefits && <Benefits lang={lang} stage="s" />}
        </div>
      </div>
      <p style="margin-top:20px"><a class="btn" href={p('pricing')}>{t('cta.seePricing')}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <h2 id="how" set:html={hl(t('home.how.title'))}></h2>
      {t('home.how.sub') && <p class="lead">{t('home.how.sub')}</p>}
      <div class="grid g4">
        {how.map(([k, h]) => <a class="card p" style="text-decoration:none" href={p(h.split('#')[0]) + (h.includes('#') ? '#' + h.split('#')[1] : '')}><h3>{t(`${k}.t`)}</h3><p>{t(`${k}.d`)}</p></a>)}
      </div>
      <h3 style="margin-top:36px">{t('home.faq.title')}</h3>
      <div class="grid g2">
        <div>
          <h3 style="color:var(--green-ink)">{t('home.faq.k')}</h3>
          <FaqList lang={lang} items={topFaqs('k')} short />
        </div>
        <div>
          <h3 style="color:var(--blue-ink)">{t('home.faq.s')}</h3>
          <FaqList lang={lang} items={topFaqs('s')} short />
        </div>
      </div>
      <p style="margin-top:12px"><a class="link" href={p('faq')}>{t('cta.allFaq')}</a></p>
    </div>
  </section>

  <JoinSteps lang={lang} />

  <section class="section" aria-labelledby="quotes">
    <div class="wrap">
      <h2 id="quotes" set:html={hl(t('home.quotes.title'))}></h2>
      {t('home.quotes.sub') && <p class="lead">{t('home.quotes.sub')}</p>}
      <div class="grid g3">
        {['student', 'parent', 'teacher'].map((r) => (
          <div class="card p voice"><h3>{t(`voice.${r}`)}</h3><p class="campus-note">{t('home.quotes.note')}</p><Photo lang={lang} ratio="4/3" label={t(`voice.${r}`)} /></div>
        ))}
      </div>
      <p class="ratings">{t('home.ratings')}</p>
      <h2 id="news" style="margin-top:48px" set:html={hl(t('home.news.title'))}></h2>
      {t('home.news.sub') && <p class="lead">{t('home.news.sub')}</p>}
      <NewsList lang={lang} limit={3} />
      <p style="margin-top:16px"><a class="link" href={p('about/news')}>{t('cta.allNews')}</a></p>
    </div>
  </section>
  <ClosingCta lang={lang} />
</Layout>
<script>import '../../scripts/home-motion.ts';</script>
