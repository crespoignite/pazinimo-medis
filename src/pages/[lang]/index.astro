---
import FaqList from '../../components/FaqList.astro';
import Rings from '../../components/Rings.astro';
import StepCards from '../../components/StepCards.astro';
import Layout from '../../layouts/Layout.astro';
import HeroCover from '../../components/HeroCover.astro';
import Photo from '../../components/Photo.astro';
import NewsList from '../../components/NewsList.astro';
import Benefits from '../../components/Benefits.astro';
import { useT, localePath, pick, type Lang } from '../../i18n';
import { langPaths } from '../../i18n/paths';
import { topFaqs } from '../../data/faq';
import { startingFrom } from '../../data/pricing';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
const how = [['home.how.1', 'about/methodologies'], ['home.how.2', 'about/programs'], ['home.how.3', 'faq#k-meals'], ['home.how.4', 'faq#s-class-size']];
const heroSlides = [
  { src: '/photos/kindergarten-hands-up.jpg', alt: t('img.kg.hands'), pos: '50% 45%' },
  { src: '/photos/school-drum.jpg', alt: t('img.sc.drum'), pos: '50% 40%' },
  { src: '/photos/school-grade5.jpg', alt: t('img.sc.grade5'), pos: '50% 40%' },
  { src: '/photos/school-teen-lab.jpg', alt: t('img.sc.teen'), pos: '50% 35%' },
  { src: '/photos/school-highschool.jpg', alt: t('img.sc.high'), pos: '50% 30%' },
];
import BrandShapes from '../../components/BrandShapes.astro';
---
<Layout lang={lang} title={t('home.title')} description={t('home.desc')} path="">
  <section class="hero" aria-labelledby="h1">
    <HeroCover lang={lang} slides={heroSlides}>
      <p class="eyebrow">{t('home.eyebrow')}</p>
      <h1 id="h1">{t('home.opener')}</h1>
      <p class="lead">{t('home.valueprop')}</p>
      <p><a class="btn accent" href={p('admissions/book')} data-cta="home_book">{t('cta.book')}</a></p>
    </HeroCover>
    <div class="wrap">
      <div class="hero-base">
        <span class="proof-line"><strong>{t('home.proof')}</strong> <small class="campus-note">(<a href="https://topmokyklos.lt/" target="_blank" rel="noopener">{t('home.proofSource')}</a>)</small></span>
        <span class="slogan">{t('site.slogan')}</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="values">
    <div class="wrap">
      <h2 id="values">{t('home.values.title')}</h2>
      <div class="grid g4">
        {[1, 2, 3, 4].map((n) => (
          <div class="card p"><h3>{t(`home.values.${n}.t`)}</h3><p>{t(`home.values.${n}.d`)}</p></div>
        ))}
      </div>
      <h2 id="stage" style="margin-top:48px">{t('home.stage.title')}</h2>
      <p class="lead">{t('home.stage.sub')}</p>
      <div class="grid g2">
        <div class="card k stage-card">
          <Rings tone="k" />
          <h3>{t('home.stage.k.t')}</h3><p>{t('home.stage.k.d')}</p>
          <div class="cities">
            <a class="btn sm" style="background:var(--green);border-color:var(--green-ink)" href={p('kindergarten') + '#vilnius'} data-cta="home_k_vilnius">{t('home.city.vilnius')}</a>
            <a class="btn sm" style="background:var(--green);border-color:var(--green-ink)" href={p('kindergarten') + '#kaunas'} data-cta="home_k_kaunas">{t('home.city.kaunas')}</a>
            <a class="btn sm ghost" href={p('kindergarten')}>{t('cta.learnMore')}</a>
          </div>
        </div>
        <div class="card s stage-card">
          <Rings tone="s" />
          <h3>{t('home.stage.s.t')}</h3><p>{t('home.stage.s.d')}</p>
          <div class="cities">
            <a class="btn sm" style="background:var(--blue);border-color:var(--blue-ink)" href={p('school') + '#vilnius'} data-cta="home_s_vilnius">{t('home.city.vilnius')}</a>
            <a class="btn sm" style="background:var(--blue);border-color:var(--blue-ink)" href={p('school') + '#kaunas'} data-cta="home_s_kaunas">{t('home.city.kaunas')}</a>
            <a class="btn sm ghost" href={p('school')}>{t('cta.learnMore')}</a>
          </div>
        </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="price">
    <div class="wrap">
      <h2 id="price">{t('home.pricing.title')}</h2>
      <p class="lead">{t('home.pricing.sub')}</p>
      <div class="grid g2">
        <div class="stage-col">
          <a class="card k" href={p('pricing') + '#kindergarten'} style="text-decoration:none;display:block"><h3>{t('pr.tab.k')}</h3><p class="num">{t('pr.from')} €{startingFrom.kindergarten}</p><p class="campus-note">{t('pr.monthlyNote')}</p></a>
          <h3 class="ben-h" style="color:var(--green-ink)">{t('home.benefits.k')}</h3>
          <Benefits lang={lang} stage="k" />
        </div>
        <div class="stage-col">
          <a class="card s" href={p('pricing') + '#school'} style="text-decoration:none;display:block"><h3>{t('pr.tab.s')}</h3><p class="num">{t('pr.from')} €{startingFrom.school}</p><p class="campus-note">{t('pr.monthlyNote')}</p></a>
          <h3 class="ben-h" style="color:var(--blue-ink)">{t('home.benefits.s')}</h3>
          <Benefits lang={lang} stage="s" />
        </div>
      </div>
      <p style="margin-top:20px"><a class="btn" href={p('pricing')}>{t('cta.seePricing')}</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="how">
    <div class="wrap">
      <h2 id="how">{t('home.how.title')}</h2>
      <div class="grid g4">
        {how.map(([k, h]) => <a class="card p" style="text-decoration:none" href={p(h.split('#')[0]) + (h.includes('#') ? '#' + h.split('#')[1] : '')}><h3>{t(`${k}.t`)}</h3><p>{t(`${k}.d`)}</p></a>)}
      </div>
      <h3 style="margin-top:36px">{t('home.faq.title')}</h3>
      <div class="grid g2">
        <div>
          <h3 style="color:var(--green-ink)">{t('home.faq.k')}</h3>
          <FaqList lang={lang} items={topFaqs('k')} />
        </div>
        <div>
          <h3 style="color:var(--blue-ink)">{t('home.faq.s')}</h3>
          <FaqList lang={lang} items={topFaqs('s')} />
        </div>
      </div>
      <p style="margin-top:12px"><a class="link" href={p('faq')}>{t('cta.allFaq')}</a></p>
    </div>
  </section>

  <section class="section alt has-deco band-cream" aria-labelledby="join">
    <BrandShapes items={[
      { s: 'cross', x: 88, y: 3, w: 100, r: 14 }, { s: 'hex', x: 1, y: 4, w: 84, r: -10, m: true },
      { s: 'bar', x: 80, y: 84, w: 130, r: 0, m: true }, { s: 'semi', x: 4, y: 88, w: 90, r: -6, m: true },
    ]} />
    <div class="wrap">
      <h2 id="join">{t('home.join.title')}</h2>
      <StepCards lang={lang} />
      <div class="row" style="margin-top:24px">
        <a class="btn ghost" href={p('admissions/ask')} data-cta="home_ask">{t('cta.ask')}</a>
        <a class="btn accent" href={p('admissions/book')} data-cta="home_book_2">{t('cta.book')}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="quotes">
    <div class="wrap">
      <h2 id="quotes">{t('home.quotes.title')}</h2>
      <div class="grid g3">
        {['student', 'parent', 'teacher'].map((r) => (
          <div class="card p voice"><h3>{t(`voice.${r}`)}</h3><p class="campus-note">{t('home.quotes.note')}</p><Photo lang={lang} ratio="4/3" label={t(`voice.${r}`)} /></div>
        ))}
      </div>
      <p class="ratings">{t('home.ratings')}</p>
      <h2 id="news" style="margin-top:48px">{t('home.news.title')}</h2>
      <NewsList lang={lang} limit={3} />
      <p style="margin-top:16px"><a class="link" href={p('about/news')}>{t('cta.allNews')}</a></p>
    </div>
  </section>
</Layout>
