---
import Layout from '../../layouts/Layout.astro';
import Photo from '../../components/Photo.astro';
import HeroCover from '../../components/HeroCover.astro';
import FaqList from '../../components/FaqList.astro';
import CityTabs from '../../components/CityTabs.astro';
import { useT, localePath, type Lang } from '../../i18n';
import { langPaths } from '../../i18n/paths';
import { topFaqs } from '../../data/faq';
import { startingFrom } from '../../data/pricing';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const mapUrl: Record<string,string> = {'ft.vg':'K. Kalinausko g. 13, Vilnius','ft.vp':'Ozo g. 37, Vilnius','ft.vk':'Pievų g. 4, Vilnius','ft.k':'Vilties g. 2, Kaunas'};
const map = (k: string) => 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(mapUrl[k]);
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
import BrandShapes from '../../components/BrandShapes.astro';
---
<Layout lang={lang} title={t('kg.title')} description={t('kg.desc')} path="kindergarten" stage="kindergarten">
  <section class="hero">
    <HeroCover lang={lang} stage="k" slides={[
      { src: '/photos/kindergarten-cars.jpg', alt: t('img.kg.cars'), pos: '50% 50%' },
      { src: '/photos/kindergarten-teacher-paint.jpg', alt: t('img.kg.teacher'), pos: '50% 40%' },
      { src: '/photos/kindergarten-painting-girl.jpg', alt: t('img.kg.paintgirl'), pos: '50% 45%' },
      { src: '/photos/kindergarten-circle.jpg', alt: t('img.kg.circle'), pos: '50% 40%' },
    ]}>
      <p class="eyebrow">{t('nav.kindergarten')}</p>
      <h1>{t('kg.h1')}</h1>
      <p class="lead">{t('kg.lead')}</p>
      <div class="row"><a class="btn accent" href={p('admissions/book')} data-cta="kg_come_see">{t('cta.comeSee')}</a><a class="btn ghost" href={p('pricing') + '#kindergarten'}>{t('cta.seePricing')}</a></div>
    </HeroCover>
    <div class="wrap" style="padding-top:20px"><CityTabs lang={lang} scrollTo="addr" /></div>
  </section>

  <section class="section alt" aria-labelledby="day">
    <div class="wrap">
      <h2 id="day">{t('kg.day.title')}</h2>
      <div class="grid g4">
        {[1, 2, 3, 4].map((n) => <div class="card k"><h3>{t(`kg.day.${n}.t`)}</h3><p>{t(`kg.day.${n}.d`)}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section has-deco band-peach" aria-labelledby="groups">
    <BrandShapes items={[
      { s: 'clover', x: 0.5, y: 3, w: 96, r: -12 }, { s: 'arch', x: 90, y: 62, w: 120, r: 10 },
      { s: 'circ', x: 93, y: 6, w: 70, r: 20, m: true }, { s: 'tri', x: 3, y: 74, w: 90, r: 8, m: true },
    ]} />
    <div class="wrap split">
      <Photo lang={lang} tone="k" ratio="4/3" src="/photos/kindergarten-joy.jpg" pos="50% 40%" alt={t('img.kg.joy')} />
      <div><h2 id="groups">{t('kg.groups.title')}</h2><p class="lead">{t('kg.groups.body')}</p></div>
    </div>
  </section>

  <section class="section alt" aria-labelledby="inc">
    <div class="wrap">
      <h2 id="inc">{t('kg.inc.title')}</h2>
      <div class="grid g3">
        {[1, 2].map((n) => <div class="card k"><h3>{t(`kg.inc.${n}.t`)}</h3><p>{t(`kg.inc.${n}.d`)}</p></div>)}
        <div class="card k"><h3>{t('kg.adapt.title')}</h3><p>{t('kg.adapt.body')}</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="price">
    <div class="wrap">
      <h2 id="price">{t('st.price.title')}</h2>
      <p class="lead">{t('pr.from')} €{startingFrom.kindergarten} {t('pr.monthlyNote')}. {t('st.price.d')}</p>
      <a class="btn ghost" href={p('pricing') + '#kindergarten'} data-cta="kg_pricing">{t('cta.seePricing')}</a>
    </div>
  </section>

  <section class="section alt" aria-labelledby="addr">
    <div class="wrap split rev">
      <div>
        <h2 id="addr">{t('st.addr.title')}</h2>
        <div id="vilnius" data-city="vilnius"><h3>{t('home.city.vilnius')}</h3><ul class="tick"><li>{t('ft.vp')} <a class="link" href={map('ft.vp')} target="_blank" rel="noopener">{t('st.addr.map')}</a></li><li>{t('ft.vk')} <a class="link" href={map('ft.vk')} target="_blank" rel="noopener">{t('st.addr.map')}</a></li></ul></div>
        <div id="kaunas" data-city="kaunas"><h3>{t('home.city.kaunas')}</h3><ul class="tick"><li>{t('ft.k')} <a class="link" href={map('ft.k')} target="_blank" rel="noopener">{t('st.addr.map')}</a></li></ul></div>
      </div>
      <div>
        <div data-city="vilnius"><Photo lang={lang} tone="k" ratio="4/3" label={t('st.addr.photo.vilnius')} /></div>
        <div data-city="kaunas"><Photo lang={lang} tone="k" ratio="4/3" label={t('st.addr.photo.kaunas')} /></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="voice">
    <div class="wrap grid g2">
      <div class="card k voice"><h2 id="voice" style="font-size:1.4rem">{t('kg.voice.title')}</h2><p class="campus-note">{t('home.quotes.note')}</p></div>
      <div>
        <h2 style="font-size:1.4rem">{t('home.faq.title')}</h2>
        <FaqList lang={lang} items={topFaqs('k')} />
        <p><a class="link" href={p('faq')}>{t('cta.allFaq')}</a></p>
      </div>
    </div>
  </section>

  <div class="strip"><div class="wrap">{t('kg.proof')}</div></div>
</Layout>
