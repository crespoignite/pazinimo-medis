---
import Layout from '../../layouts/Layout.astro';
import CityTabs from '../../components/CityTabs.astro';
import FaqList from '../../components/FaqList.astro';
import { faqs } from '../../data/faq';
import { useT, localePath, type Lang } from '../../i18n';
import { langPaths } from '../../i18n/paths';
import { kindergarten, school, extras, eur } from '../../data/pricing';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
const p = (s: string) => localePath(lang, s);
let rid = 0;
const inc = (stage: 'k' | 's') => [1, 2, 3, 4].map((n) => t(`pr.row.${stage}${n}`));
---
<Layout lang={lang} title={t('pr.title')} description={t('pr.desc')} path="pricing">
  <section class="section">
    <div class="wrap">
      <h1>{t('pr.h1')}</h1>
      <p class="lead">{t('pr.lead')}</p>
      <p class="campus-note"><em>{t('pr.verify')}</em></p>
      <CityTabs lang={lang} year />

      <h2 id="kindergarten" style="margin-top:40px;color:var(--green-ink)">{t('pr.tab.k')}</h2>
      <div class="scroll" data-stage="kindergarten" style="--accent-bg:var(--green-bg)">
        <table class="price">
          <thead><tr><th>{t('pr.preschool')}</th><th>{t('pr.col.month')}</th><th></th></tr></thead>
          <tbody>
            {kindergarten.preschool.map((r) => (
              <Fragment>
                <tr class="pr-row"><td><button type="button" class="pr-toggle" aria-expanded="false" aria-controls={`pr-d-${++rid}`}><span>{t(r.labelKey)}<small>{t('pr.instalments', { n: r.instalments })}</small></span></button></td><td class="n">€{eur(r.monthly)}</td><td>{t('pr.upfront', { n: eur(r.upfront) })}</td></tr>
                <tr class="pr-detail" id={`pr-d-${rid}`} hidden><td colspan="3"><strong>{t('pr.row.what')}</strong><ul class="tick">{inc('k').map((x) => <li>{x}</li>)}</ul><p class="campus-note">{t('pr.row.note')}</p></td></tr>
              </Fragment>
            ))}
          </tbody>
          <thead><tr><th>{t('pr.preprimary')}</th><th></th><th></th></tr></thead>
          <tbody>
            {kindergarten.preprimary.map((r: any) => (
              <Fragment>
                <tr class="pr-row" data-city={r.key.startsWith('a') ? 'vilnius' : 'kaunas'}><td><button type="button" class="pr-toggle" aria-expanded="false" aria-controls={`pr-d-${++rid}`}><span>{t(r.labelKey)}, {t(r.sub).toLowerCase()}<small>{t('pr.instalments', { n: r.instalments })}</small></span></button></td><td class="n">€{eur(r.monthly)}</td><td>{t('pr.upfront', { n: eur(r.upfront) })}</td></tr>
                <tr class="pr-detail" data-city={r.key.startsWith('a') ? 'vilnius' : 'kaunas'} id={`pr-d-${rid}`} hidden><td colspan="3"><strong>{t('pr.row.what')}</strong><ul class="tick">{inc('k').map((x) => <li>{x}</li>)}</ul><p class="campus-note">{t('pr.row.note')}</p></td></tr>
              </Fragment>
            ))}
          </tbody>
        </table>
      </div>
      <p class="campus-note">{t('pr.meals.k')}</p>
      <h3 style="margin-top:28px;color:var(--green-ink)">{t('pr.inc.title')}</h3>
      <div class="grid g3" style="margin-top:12px">
        {[1, 2, 3].map((n) => <div class="card k"><h3>{t(`pr.inc.${n}`)}</h3><p>{t('pr.inc.d')}</p></div>)}
      </div>

      <h2 id="school" style="margin-top:48px;color:var(--blue-ink)">{t('pr.tab.s')}</h2>
      <div class="grid g2">
        {[['vilnius', school.vilnius], ['kaunas', school.kaunas]].map(([city, rows]: any) => (
          <div class="scroll" data-city={city} style="--accent-bg:var(--blue-bg)">
            <table class="price">
              <thead><tr><th>{t(`pr.${city}`)}</th><th></th><th></th></tr></thead>
              <tbody>
                {rows.map((r: any) => (
                  <Fragment>
                <tr class="pr-row"><td><button type="button" class="pr-toggle" aria-expanded="false" aria-controls={`pr-d-${++rid}`}><span>{r.labelKey ? t(r.labelKey) : t('pr.grades', { g: r.grades })}</span></button></td><td class="n">€{eur(r.monthly)}</td><td>{t('pr.upfront', { n: eur(r.upfront) })}</td></tr>
                <tr class="pr-detail" id={`pr-d-${rid}`} hidden><td colspan="3"><strong>{t('pr.row.what')}</strong><ul class="tick">{inc('s').map((x) => <li>{x}</li>)}</ul><p class="campus-note">{t('pr.row.note')}</p></td></tr>
              </Fragment>
                ))}
              </tbody>
            </table>
          </div>
        ))}
      </div>
      <p class="campus-note">{t('pr.meals.s')}</p>

      <div class="grid g2" style="margin-top:40px">
        <div class="card p"><h3>{t('pr.extras.title')}</h3>
          <ul class="tick"><li>{t('pr.enrol')}: €{extras.enrolment}</li><li>{t('pr.after')}: €{extras.afterSchool}</li></ul></div>
        <div class="card p"><h3>{t('pr.discounts.title')}</h3>
          <ul class="tick">{[1,2,3,4].map((n) => <li>{t(`pr.d.${n}`)}</li>)}</ul>
          <p class="campus-note">{t('pr.discounts.note')} {t('pr.d.pct')}</p></div>
      </div>

      <h2 style="margin-top:48px">{t('pr.q.title')}</h2>
      <FaqList lang={lang} items={[faqs.find((f) => f.id === 'price')!, faqs.find((f) => f.id === 'subsidies')!]} />

      <div class="card" style="margin-top:40px;text-align:center">
        <h3>{t('pr.cta.title')}</h3><p>{t('pr.cta.d')}</p>
        <a class="btn accent" href={p('admissions/ask')} data-cta="pricing_ask">{t('cta.ask')}</a>
      </div>
    </div>
  </section>
</Layout>
<script>
  document.querySelectorAll<HTMLButtonElement>('.pr-toggle').forEach((b) => {
    b.addEventListener('click', () => {
      const open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      const d = document.getElementById(b.getAttribute('aria-controls')!);
      if (d) d.hidden = open;
      b.closest('tr')?.classList.toggle('is-open', !open);
    });
  });
</script>
